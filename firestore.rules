rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Invoices collection: accessible by app and Midtrans payment webhooks
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Payments collection: records payment attempts and status updates from Midtrans webhook
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Classes collection
    match /classes/{classId} {
      allow read, write: if true;
    }

    // SPP Settings collection
    match /spp_settings/{settingId} {
      allow read, write: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Parents collection
    match /parents/{parentId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Settings collection (school profile, system configs)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Catch-all fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

